{% comment %}
  Luxury Brand Story Section
  Renders a 2-column editorial brand story for ATIF'S STYLE.
{% endcomment %}

<section
  id="luxury-brand-story-{{ section.id }}"
  class="luxury-brand-story"
  style="
    --section-bg: {{ section.settings.background_color | default: '#F7F4EF' }};
    --section-pt: {{ section.settings.padding_top | default: 80 }}px;
    --section-pb: {{ section.settings.padding_bottom | default: 80 }}px;
  "
>
  <div class="luxury-brand-story__container page-width">
    <div class="luxury-brand-story__grid luxury-brand-story__grid--image-{{ section.settings.image_position | default: 'left' }}">
      <div class="luxury-brand-story__media-col">
        <div class="luxury-brand-story__image-wrapper">
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '550, 750, 1100, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: section.settings.image.alt | default: section.settings.heading,
                class: 'luxury-brand-story__image'
            }}
          {% else %}
            <img
              src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1600&q=85&auto=format&fit=crop"
              alt="ATIF'S STYLE Brand Philosophy & Haute Couture"
              class="luxury-brand-story__image"
              loading="lazy"
              width="1600"
              height="1200"
            >
          {% endif %}
        </div>
      </div>

      <div class="luxury-brand-story__content-col">
        <div class="luxury-brand-story__content">
          <span class="luxury-brand-story__kicker">
            ATIF'S STYLE
          </span>

          <h2 class="luxury-brand-story__heading">
            {{ section.settings.heading | default: 'THE ART OF EVERYDAY ELEGANCE' }}
          </h2>

          <div class="luxury-brand-story__gold-divider" aria-hidden="true"></div>

          <div class="luxury-brand-story__description">
            <p>
              {{ section.settings.description | default: "At Atif's Style, we believe great style is more than what you wear. It is how you express yourself. Discover thoughtfully selected fashion that brings together modern design, timeless appeal and everyday comfort." }}
            </p>
          </div>

          {% if section.settings.button_text != blank %}
            <a
              href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
              class="luxury-brand-story__button"
            >
              {{ section.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .luxury-brand-story {
    background-color: var(--section-bg, #F7F4EF);
    padding-block-start: var(--section-pt, 80px);
    padding-block-end: var(--section-pb, 80px);
    width: 100%;
    position: relative;
  }

  .luxury-brand-story__container {
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-padding, 24px);
  }

  .luxury-brand-story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .luxury-brand-story__grid--image-right .luxury-brand-story__media-col {
    order: 2;
  }

  .luxury-brand-story__grid--image-right .luxury-brand-story__content-col {
    order: 1;
  }

  @media screen and (max-width: 989px) {
    .luxury-brand-story__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .luxury-brand-story__grid--image-right .luxury-brand-story__media-col {
      order: 1;
    }

    .luxury-brand-story__grid--image-right .luxury-brand-story__content-col {
      order: 2;
    }
  }

  .luxury-brand-story__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: 4px;
    overflow: hidden;
    background-color: #EDE8DF;
    border: 1px solid rgba(198, 166, 107, 0.2);
    box-shadow: 0 16px 40px rgba(17, 17, 17, 0.06);
  }

  .luxury-brand-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
    will-change: transform;
  }

  .luxury-brand-story__image-wrapper:hover .luxury-brand-story__image {
    transform: scale(1.03);
  }

  .luxury-brand-story__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 540px;
  }

  .luxury-brand-story__kicker {
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C6A66B;
    margin-bottom: 0.75rem;
  }

  .luxury-brand-story__heading {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-size: clamp(1.65rem, 3.2vw, 3rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #111111;
    margin: 0;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  @media screen and (max-width: 549px) {
    .luxury-brand-story__heading {
      font-size: clamp(1.35rem, 5.5vw, 1.85rem);
      line-height: 1.25;
    }

    .luxury-brand-story__button {
      width: 100%;
      justify-content: center;
      text-align: center;
      padding: 15px 20px;
    }
  }

  .luxury-brand-story__gold-divider {
    width: 44px;
    height: 1.5px;
    background-color: #C6A66B;
    margin: 1.25rem 0 1.5rem 0;
  }

  .luxury-brand-story__description {
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(0.95rem, 1.15vw, 1.05rem);
    line-height: 1.8;
    color: #444444;
    letter-spacing: 0.02em;
    margin: 0 0 2rem 0;
  }

  .luxury-brand-story__description p {
    margin: 0;
  }

  .luxury-brand-story__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 34px;
    background-color: #111111;
    color: #FFFFFF;
    border: 1px solid #111111;
    border-radius: 4px;
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .luxury-brand-story__button:hover {
    background-color: #C6A66B;
    border-color: #C6A66B;
    color: #111111;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(198, 166, 107, 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .luxury-brand-story__image,
    .luxury-brand-story__button {
      transition: none !important;
      transform: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Luxury Brand Story",
  "tag": "section",
  "class": "luxury-brand-story-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE ART OF EVERYDAY ELEGANCE"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "At Atif's Style, we believe great style is more than what you wear. It is how you express yourself. Discover thoughtfully selected fashion that brings together modern design, timeless appeal and everyday comfort."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "DISCOVER OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F7F4EF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Luxury Brand Story",
      "settings": {
        "heading": "THE ART OF EVERYDAY ELEGANCE",
        "description": "At Atif's Style, we believe great style is more than what you wear. It is how you express yourself. Discover thoughtfully selected fashion that brings together modern design, timeless appeal and everyday comfort.",
        "button_text": "DISCOVER OUR STORY",
        "image_position": "left"
      }
    }
  ]
}
{% endschema %}

