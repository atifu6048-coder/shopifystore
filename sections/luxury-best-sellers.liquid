{% comment %}
  Luxury Best Sellers Section
  Renders a high-end product showcase for ATIF'S STYLE titled "THE EDIT — BEST SELLERS".
{% endcomment %}

{% liquid
  assign selected_collection = section.settings.collection
  if selected_collection != blank and selected_collection.products_count > 0
    assign products = selected_collection.products
  elsif collections['all'] != blank and collections['all'].products_count > 0
    assign products = collections['all'].products
  else
    assign products = collections.all.products
  endif
  assign product_limit = section.settings.products_to_show | default: 4
%}

<section
  id="luxury-best-sellers-{{ section.id }}"
  class="luxury-best-sellers"
  style="
    --section-bg: {{ section.settings.background_color | default: '#F7F4EF' }};
    --section-pt: {{ section.settings.padding_top | default: 64 }}px;
    --section-pb: {{ section.settings.padding_bottom | default: 64 }}px;
  "
>
  <div class="luxury-best-sellers__container page-width">
    {% if section.settings.heading != blank or section.settings.subtitle != blank %}
      <div class="luxury-best-sellers__header">
        {% if section.settings.heading != blank %}
          <h2 class="luxury-best-sellers__title">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="luxury-best-sellers__subtitle">
            {{ section.settings.subtitle }}
          </p>
        {% endif %}
        <div class="luxury-best-sellers__gold-divider" aria-hidden="true"></div>
      </div>
    {% endif %}

    {% if products.size > 0 %}
      <div class="luxury-best-sellers__grid">
        {% for product in products limit: product_limit %}
          {% liquid
            assign on_sale = false
            if product.compare_at_price > product.price
              assign on_sale = true
            endif
            assign has_secondary_image = false
            if section.settings.show_secondary_image and product.images.size > 1
              assign has_secondary_image = true
            endif
          %}
          <div class="luxury-best-sellers__item">
            <div class="luxury-product-card">
              <div class="luxury-product-card__media-wrapper">
                <a
                  href="{{ product.url }}"
                  class="luxury-product-card__image-link"
                  aria-label="{{ product.title | escape }}"
                >
                  {% if product.featured_image != blank %}
                    {{
                      product.featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 720, 900',
                        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 50vw',
                        alt: product.featured_image.alt | default: product.title,
                        class: 'luxury-product-card__image luxury-product-card__image--primary'
                    }}
                    {% if has_secondary_image %}
                      {{
                        product.images[1]
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '360, 540, 720, 900',
                          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 50vw',
                          alt: product.images[1].alt | default: product.title,
                          class: 'luxury-product-card__image luxury-product-card__image--secondary'
                      }}
                    {% endif %}
                  {% else %}
                    <div class="luxury-product-card__placeholder">
                      <span>{{ product.title | slice: 0, 1 }}</span>
                    </div>
                  {% endif %}
                </a>

                {% comment %} Genuine badges only {% endcomment %}
                {% if product.available == false %}
                  <span class="luxury-product-card__badge luxury-product-card__badge--sold-out">
                    SOLD OUT
                  </span>
                {% elsif on_sale %}
                  <span class="luxury-product-card__badge luxury-product-card__badge--sale">
                    SALE
                  </span>
                {% endif %}
              </div>

              <div class="luxury-product-card__content">
                <h3 class="luxury-product-card__title">
                  <a href="{{ product.url }}" class="luxury-product-card__title-link">
                    {{ product.title }}
                  </a>
                </h3>

                <div class="luxury-product-card__price-wrapper">
                  <span class="luxury-product-card__price">
                    {{ product.price | money }}
                  </span>
                  {% if on_sale %}
                    <s class="luxury-product-card__compare-price">
                      {{ product.compare_at_price | money }}
                    </s>
                  {% endif %}
                </div>

                <div class="luxury-product-card__actions">
                  <a
                    href="{{ product.url }}"
                    class="luxury-product-card__view-link"
                  >
                    VIEW PRODUCT
                    <svg
                      class="luxury-product-card__arrow"
                      width="12"
                      height="8"
                      viewBox="0 0 12 8"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      aria-hidden="true"
                    >
                      <path d="M8 1L11 4M11 4L8 7M11 4H1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>

                  {% if section.settings.show_quick_add %}
                    {% if product.available == false %}
                      <button
                        type="button"
                        class="luxury-product-card__btn luxury-product-card__btn--disabled"
                        disabled
                      >
                        OUT OF STOCK
                      </button>
                    {% elsif product.has_only_default_variant %}
                      <form
                        method="post"
                        action="{{ routes.cart_add_url }}"
                        class="luxury-product-card__form"
                        data-luxury-quick-add
                      >
                        <input
                          type="hidden"
                          name="id"
                          value="{{ product.selected_or_first_available_variant.id }}"
                        >
                        <input type="hidden" name="quantity" value="1">
                        <button
                          type="submit"
                          class="luxury-product-card__btn"
                          aria-label="Add {{ product.title | escape }} to bag"
                        >
                          + QUICK ADD
                        </button>
                      </form>
                    {% else %}
                      <a
                        href="{{ product.url }}"
                        class="luxury-product-card__btn luxury-product-card__btn--options"
                        aria-label="Choose options for {{ product.title | escape }}"
                      >
                        CHOOSE OPTIONS
                      </a>
                    {% endif %}
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="luxury-best-sellers__empty">
        <p>No products found. Please assign products to this collection in your Shopify Admin.</p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .luxury-best-sellers {
    background-color: var(--section-bg, #F7F4EF);
    padding-block-start: var(--section-pt, 64px);
    padding-block-end: var(--section-pb, 64px);
    width: 100%;
    position: relative;
  }

  .luxury-best-sellers__container {
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-padding, 24px);
  }

  .luxury-best-sellers__header {
    text-align: center;
    margin-block-end: 2.75rem;
  }

  .luxury-best-sellers__title {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #111111;
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  .luxury-best-sellers__subtitle {
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    color: #555555;
    letter-spacing: 0.02em;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .luxury-best-sellers__gold-divider {
    width: 44px;
    height: 1.5px;
    background-color: #C6A66B;
    margin: 1.25rem auto 0 auto;
  }

  .luxury-best-sellers__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media screen and (max-width: 989px) {
    .luxury-best-sellers__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media screen and (max-width: 549px) {
    .luxury-best-sellers__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  .luxury-best-sellers__item {
    min-width: 0;
  }

  .luxury-product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #FFFFFF;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid rgba(198, 166, 107, 0.16);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .luxury-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(17, 17, 17, 0.08);
    border-color: #C6A66B;
  }

  .luxury-product-card__media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #EDE8DF;
  }

  .luxury-product-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .luxury-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
    will-change: transform;
    display: block;
  }

  .luxury-product-card__image--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .luxury-product-card:hover .luxury-product-card__image--primary {
    transform: scale(1.04);
  }

  .luxury-product-card:hover .luxury-product-card__image--secondary {
    opacity: 1;
    transform: scale(1.04);
  }

  .luxury-product-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: #EAE5DC;
    color: #111111;
    font-family: var(--font-heading--family);
    font-size: 2.5rem;
    font-weight: 700;
  }

  .luxury-product-card__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 8px;
    border-radius: 2px;
    font-family: var(--font-body--family);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    z-index: 2;
    pointer-events: none;
  }

  .luxury-product-card__badge--sale {
    background-color: #C6A66B;
    color: #111111;
  }

  .luxury-product-card__badge--sold-out {
    background-color: #111111;
    color: #FFFFFF;
  }

  .luxury-product-card__content {
    padding: 16px 14px 18px 14px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-grow: 1;
    gap: 8px;
    background: #FFFFFF;
  }

  @media screen and (max-width: 549px) {
    .luxury-product-card__content {
      padding: 10px 8px 12px 8px;
      gap: 5px;
    }

    .luxury-product-card__title {
      font-size: 0.875rem;
      letter-spacing: 0.02em;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .luxury-product-card__btn {
      padding: 8px 6px;
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
    }
  }

  .luxury-product-card__title {
    font-family: var(--font-heading--family, 'Playfair Display', Georgia, serif);
    font-size: clamp(0.95rem, 1.1vw, 1.15rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.3;
  }

  .luxury-product-card__title-link {
    text-decoration: none;
    color: #111111;
    transition: color 0.25s ease;
  }

  .luxury-product-card__title-link:hover {
    color: #C6A66B;
  }

  .luxury-product-card__price-wrapper {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .luxury-product-card__price {
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.9375rem;
    font-weight: 600;
    color: #111111;
  }

  .luxury-product-card__compare-price {
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.8125rem;
    color: #888888;
    text-decoration: line-through;
  }

  .luxury-product-card__actions {
    margin-top: auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 6px;
  }

  .luxury-product-card__view-link {
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.725rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #111111;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.3s ease;
  }

  .luxury-product-card__view-link:hover {
    color: #C6A66B;
  }

  .luxury-product-card__view-link:hover .luxury-product-card__arrow {
    transform: translateX(4px);
  }

  .luxury-product-card__arrow {
    transition: transform 0.3s ease;
  }

  .luxury-product-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 10px 12px;
    background-color: #111111;
    color: #FFFFFF;
    border: 1px solid #111111;
    border-radius: 4px;
    font-family: var(--font-body--family, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.725rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }

  .luxury-product-card__btn:hover:not(:disabled) {
    background-color: #C6A66B;
    border-color: #C6A66B;
    color: #111111;
  }

  .luxury-product-card__btn--disabled {
    background-color: #E2DDD2;
    border-color: #E2DDD2;
    color: #888888;
    cursor: not-allowed;
  }

  .luxury-product-card__form {
    margin: 0;
    width: 100%;
  }

  .luxury-best-sellers__empty {
    text-align: center;
    padding: 3rem 1rem;
    color: #666666;
    font-family: var(--font-body--family);
    font-size: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .luxury-product-card,
    .luxury-product-card__image,
    .luxury-product-card__arrow,
    .luxury-product-card__btn {
      transition: none !important;
      transform: none !important;
    }
  }
{% endstylesheet %}

<script>
  if (!window.luxuryQuickAddInitialized) {
    window.luxuryQuickAddInitialized = true;
    document.addEventListener('DOMContentLoaded', () => {
      document.addEventListener('submit', async (e) => {
        const form = e.target.closest('[data-luxury-quick-add]');
        if (!form) return;
        e.preventDefault();

        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = 'ADDING...';
        }

        try {
          const formData = new FormData(form);
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          });
          if (res.ok) {
            if (submitBtn) {
              submitBtn.innerHTML = 'ADDED &#10003;';
              setTimeout(() => {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
              }, 2000);
            }
            document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
            document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
          } else {
            form.submit();
          }
        } catch (err) {
          form.submit();
        }
      });
    });
  }
</script>

{% schema %}
{
  "name": "Luxury Best Sellers",
  "tag": "section",
  "class": "luxury-best-sellers-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE EDIT — BEST SELLERS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover the pieces everyone is talking about."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F7F4EF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Luxury Best Sellers",
      "settings": {
        "heading": "THE EDIT — BEST SELLERS",
        "subtitle": "Discover the pieces everyone is talking about.",
        "products_to_show": 4,
        "show_quick_add": true,
        "show_secondary_image": true
      }
    }
  ]
}
{% endschema %}
